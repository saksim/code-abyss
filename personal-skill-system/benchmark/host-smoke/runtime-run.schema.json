{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-skill-system.local/personal-skill-system/benchmark/host-smoke/runtime-run.schema.json",
  "title": "Runtime Host Smoke Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "run-id",
    "executed-at",
    "host",
    "source-runtime-proof",
    "selection",
    "results"
  ],
  "properties": {
    "schema-version": {
      "type": "integer",
      "const": 1
    },
    "run-id": {
      "type": "string",
      "minLength": 8
    },
    "executed-at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "string",
      "minLength": 2
    },
    "source-runtime-proof": {
      "type": "string",
      "pattern": "^registry\\/runtime-proof\\.generated\\.json$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "skills"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "single",
            "all"
          ]
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "kind",
          "level-before",
          "status",
          "manifest",
          "contract",
          "command-count",
          "passed-commands",
          "commands"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tool",
              "guard"
            ]
          },
          "level-before": {
            "type": "string",
            "enum": [
              "declared-only",
              "declared-and-tested",
              "host-smoked"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "manifest": {
            "type": "string",
            "pattern": "^skills\\/.+\\/scripts\\/smoke\\.json$"
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest",
              "commands"
            ],
            "properties": {
              "manifest": {
                "type": "string",
                "pattern": "^skills\\/.+\\/scripts\\/smoke\\.json$"
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "argv",
                    "expect"
                  ],
                  "properties": {
                    "cwd": {
                      "type": "string",
                      "enum": [
                        "skill-dir",
                        "bundle-root"
                      ]
                    },
                    "argv": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "expect": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "timeout-ms": {
                      "type": "integer",
                      "minimum": 1000
                    }
                  }
                }
              }
            }
          },
          "command-count": {
            "type": "integer",
            "minimum": 1
          },
          "passed-commands": {
            "type": "integer",
            "minimum": 0
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "expect",
                "status",
                "observed",
                "mismatches"
              ],
              "properties": {
                "cwd": {
                  "type": "string",
                  "enum": [
                    "skill-dir",
                    "bundle-root"
                  ]
                },
                "argv": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "expect": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "timeout-ms": {
                  "type": "integer",
                  "minimum": 1000
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "exit-code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "signal": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "duration-ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "json-parse-ok": {
                  "type": "boolean"
                },
                "observed": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "mismatches": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "stdout-preview": {
                  "type": "string"
                },
                "stderr-preview": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
