{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-abyss.local/personal-skill-system/admission-ledger.schema.json",
  "title": "Portable Personal Skill Admission Ledger Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "generated-at",
    "source",
    "summary",
    "entries"
  ],
  "properties": {
    "schema-version": {
      "type": "integer",
      "const": 2
    },
    "generated-at": {
      "$ref": "#/$defs/isoDateTime"
    },
    "source": {
      "type": "string",
      "const": "managed-via-manage-skill"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "active",
        "open",
        "planned",
        "in-progress",
        "blocked",
        "deferred",
        "implemented",
        "cancelled",
        "resolved",
        "advised-reuse",
        "advised-upgrade",
        "advised-noop"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "in-progress": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "implemented": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "advised-reuse": {
          "type": "integer",
          "minimum": 0
        },
        "advised-upgrade": {
          "type": "integer",
          "minimum": 0
        },
        "advised-noop": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request-id",
          "request",
          "decision",
          "status",
          "recorded-at"
        ],
        "properties": {
          "request-id": {
            "$ref": "#/$defs/registryId"
          },
          "request": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "suggested-kind": {
            "type": "string",
            "enum": [
              "router",
              "domain",
              "workflow",
              "tool",
              "guard",
              "adapter"
            ]
          },
          "inferred-intent-tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tag"
            },
            "uniqueItems": true
          },
          "opportunity-id": {
            "$ref": "#/$defs/registryId"
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "create-new-skill",
                  "clarify-or-merge-boundary",
                  "reuse-existing-skill",
                  "upgrade-existing-skill"
                ]
              },
              "target_skill": {
                "$ref": "#/$defs/skillName"
              },
              "target_kind": {
                "type": "string",
                "enum": [
                  "router",
                  "domain",
                  "workflow",
                  "tool",
                  "guard",
                  "adapter"
                ]
              },
              "primary_skill": {
                "$ref": "#/$defs/skillName"
              },
              "competing_skill": {
                "$ref": "#/$defs/skillName"
              },
              "suggested_kind": {
                "type": "string",
                "enum": [
                  "router",
                  "domain",
                  "workflow",
                  "tool",
                  "guard",
                  "adapter"
                ]
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "planned",
              "in-progress",
              "blocked",
              "deferred",
              "implemented",
              "cancelled",
              "resolved",
              "advised-reuse",
              "advised-upgrade",
              "advised-noop"
            ]
          },
          "recorded-at": {
            "$ref": "#/$defs/isoDateTime"
          },
          "created-skill": {
            "$ref": "#/$defs/skillName"
          },
          "note": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "resolved-at": {
            "$ref": "#/$defs/isoDateTime"
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "skillName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "registryId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 160
    },
    "portablePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
