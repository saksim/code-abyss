{
  "schema-version": 1,
  "commands": [
    {
      "cwd": "skill-dir",
      "argv": [
        "node",
        "scripts/run.js",
        "--target",
        ".",
        "--changed-files",
        "SKILL.md",
        "--json"
      ],
      "expect": {
        "guard": "pre-commit-gate",
        "status": "pass"
      },
      "timeout-ms": 10000
    }
  ]
}
