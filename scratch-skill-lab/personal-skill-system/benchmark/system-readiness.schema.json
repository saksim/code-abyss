{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-abyss.local/personal-skill-system/benchmark/system-readiness.schema.json",
  "title": "Personal Skill System Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "generated-at",
    "sources",
    "status",
    "signals",
    "host-smoke-policy",
    "summary",
    "notes"
  ],
  "properties": {
    "schema-version": {
      "type": "integer",
      "const": 1
    },
    "generated-at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark-summary",
        "host-smoke-scorecard",
        "runtime-proof",
        "route-fixtures",
        "review-queue",
        "skill-opportunity-queue",
        "skill-investment-backlog"
      ],
      "properties": {
        "benchmark-summary": {
          "type": "string",
          "pattern": "^benchmark\\/summary\\.generated\\.json$"
        },
        "host-smoke-scorecard": {
          "type": "string",
          "pattern": "^benchmark\\/host-smoke\\/scorecard\\.generated\\.json$"
        },
        "runtime-proof": {
          "type": "string",
          "pattern": "^registry\\/runtime-proof\\.generated\\.json$"
        },
        "route-fixtures": {
          "type": "string",
          "pattern": "^registry\\/route-fixtures\\.generated\\.json$"
        },
        "review-queue": {
          "type": "string",
          "pattern": "^registry\\/review-queue\\.generated\\.json$"
        },
        "skill-opportunity-queue": {
          "type": "string",
          "pattern": "^registry\\/skill-opportunity-queue\\.generated\\.json$"
        },
        "skill-investment-backlog": {
          "type": "string",
          "pattern": "^registry\\/skill-investment-backlog\\.generated\\.json$"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "attention",
        "blocked"
      ]
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark",
        "route-evidence",
        "runtime-proof",
        "host-smoke",
        "review-cadence"
      ],
      "properties": {
        "benchmark": {
          "$ref": "#/$defs/benchmarkSignal"
        },
        "route-evidence": {
          "$ref": "#/$defs/routeEvidenceSignal"
        },
        "runtime-proof": {
          "$ref": "#/$defs/runtimeProofSignal"
        },
        "host-smoke": {
          "$ref": "#/$defs/hostSmokeSignal"
        },
        "review-cadence": {
          "$ref": "#/$defs/reviewCadenceSignal"
        }
      }
    },
    "host-smoke-policy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hostSmokePolicyEntry"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live-scripted-skills",
        "stable-user-invocable-skills",
        "route-evidence-covered-skills",
        "runtime-proof-entries",
        "host-smoke-capable-skills",
        "review-governed-skills",
        "review-overdue-skills",
        "review-due-soon-skills",
        "review-missing-metadata-skills"
      ],
      "properties": {
        "live-scripted-skills": {
          "type": "integer",
          "minimum": 0
        },
        "stable-user-invocable-skills": {
          "type": "integer",
          "minimum": 0
        },
        "route-evidence-covered-skills": {
          "type": "integer",
          "minimum": 0
        },
        "runtime-proof-entries": {
          "type": "integer",
          "minimum": 0
        },
        "host-smoke-capable-skills": {
          "type": "integer",
          "minimum": 0
        },
        "review-governed-skills": {
          "type": "integer",
          "minimum": 0
        },
        "review-overdue-skills": {
          "type": "integer",
          "minimum": 0
        },
        "review-due-soon-skills": {
          "type": "integer",
          "minimum": 0
        },
        "review-missing-metadata-skills": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "attention",
        "blocked"
      ]
    },
    "benchmarkSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file",
        "summary_status",
        "run_count"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "file": {
          "type": "string",
          "pattern": "^benchmark\\/summary\\.generated\\.json$"
        },
        "summary_status": {
          "type": "string",
          "enum": [
            "empty",
            "ok",
            "partial"
          ]
        },
        "run_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "routeEvidenceSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stable_skills",
        "covered_skills"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "stable_skills": {
          "type": "integer",
          "minimum": 0
        },
        "covered_skills": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtimeProofSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "live_scripted_skills",
        "runtime_proof_entries"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "live_scripted_skills": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_proof_entries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hostSmokeSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "host_smoke_capable_skills",
        "satisfied",
        "passing",
        "missing",
        "failing",
        "stale",
        "contract_drift",
        "policy"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "host_smoke_capable_skills": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied": {
          "type": "integer",
          "minimum": 0
        },
        "passing": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "failing": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "contract_drift": {
          "type": "integer",
          "minimum": 0
        },
        "policy": {
          "$ref": "#/$defs/policySummary"
        }
      }
    },
    "reviewCadenceSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "governed-skills",
        "overdue",
        "due-soon",
        "scheduled",
        "missing-metadata",
        "stable-overdue",
        "stable-missing-metadata"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "governed-skills": {
          "type": "integer",
          "minimum": 0
        },
        "overdue": {
          "type": "integer",
          "minimum": 0
        },
        "due-soon": {
          "type": "integer",
          "minimum": 0
        },
        "scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "missing-metadata": {
          "type": "integer",
          "minimum": 0
        },
        "stable-overdue": {
          "type": "integer",
          "minimum": 0
        },
        "stable-missing-metadata": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiers",
        "statuses"
      ],
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical",
            "standard",
            "experimental"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "standard": {
              "type": "integer",
              "minimum": 0
            },
            "experimental": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "attention",
            "blocked"
          ],
          "properties": {
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "attention": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "hostSmokePolicyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "kind",
        "tier",
        "status",
        "level",
        "target-level",
        "requires-freshness",
        "evidence-status",
        "governance-status"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "tool",
            "guard"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "critical",
            "standard",
            "experimental"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "level": {
          "type": "string",
          "enum": [
            "declared-only",
            "declared-and-tested",
            "host-smoked"
          ]
        },
        "target-level": {
          "type": "string",
          "enum": [
            "declared-only",
            "declared-and-tested",
            "host-smoked"
          ]
        },
        "requires-freshness": {
          "type": "boolean"
        },
        "max-freshness-days": {
          "type": "integer",
          "minimum": 1
        },
        "evidence-status": {
          "type": "string",
          "enum": [
            "passing",
            "stale",
            "failing",
            "missing",
            "contract-drift",
            "invalid-contract"
          ]
        },
        "governance-status": {
          "type": "string",
          "enum": [
            "satisfied",
            "not-host-smoked",
            "stale",
            "failing",
            "missing",
            "contract-drift",
            "invalid-contract"
          ]
        }
      }
    }
  }
}
